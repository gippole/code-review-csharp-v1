<Window x:Class="code_review_csharp_v1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:code_review_csharp_v1"
        mc:Ignorable="d"
        Title="Code Review App" Height="450" Width="800"
        Background="#0D0D1E">
    <Window.Resources>
        <SolidColorBrush x:Key="BorderBrush" Color="#2D2D50" />
        <SolidColorBrush x:Key="SeverityLowBrush" Color="#4CAF50" />
        <SolidColorBrush x:Key="SeverityMedBrush" Color="#FFA726" />
        <SolidColorBrush x:Key="SeverityHighBrush" Color="#EF5350" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9090B0" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E8E8F8" />
        <SolidColorBrush x:Key="BgMidBrush" Color="#12122A" />
        <SolidColorBrush x:Key="BgCardBrush" Color="#1A1A2E" />

        <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#7B61FF" Offset="0.0" />
            <GradientStop Color="#4C3FCC" Offset="1.0" />
        </LinearGradientBrush>
        <!-- ===== ScrollBar style (thin, dark) ===== -->
        <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- ===== Code TextBox ===== -->
        <Style x:Key="CodeBox" TargetType="TextBox">
            <Setter Property="Background" Value="#12121E"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Courier New"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="AcceptsTab" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Primary Button ===== -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#9580FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5E4FCC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#44446A"/>
                                <Setter Property="Foreground" Value="#666688"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Ghost Button ===== -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A3E"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Section Label ===== -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- ===== Status Bar ===== -->
        <Style x:Key="StatusLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ===== Severity Badge template helper (used in DataTemplate) ===== -->
        <local:SeverityToColorConverter x:Key="SevColorConv"/>
        <local:SeverityToLabelConverter x:Key="SevLabelConv"/>
        <local:SeverityToIconConverter x:Key="SevIconConv"/>
        <local:NullToCollapsedConverter x:Key="NullToCollapsed"/>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Title bar -->
            <RowDefinition Height="56"/>
            <!-- Main content -->
            <RowDefinition Height="*"/>
            <!-- Status bar -->
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <!-- ===== Title bar ===== -->
        <Border Grid.Row="0" Background="{StaticResource BgMidBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔍" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ローカル AI コードレビュー"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Foundry Local  ·  Phi-4-mini  ·  CPU推論"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Init status badge -->
                <Border x:Name="InitBadge" HorizontalAlignment="Right" VerticalAlignment="Center"
                        CornerRadius="12" Padding="12,4"
                        Background="#332A52">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="InitDot" Width="8" Height="8" Margin="0,0,6,0"
                                 Fill="#888"/>
                        <TextBlock x:Name="InitLabel" Text="初期化待ち"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== Main content (Left: Code | Right: Results) ===== -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left panel: Code input ── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="📝  コード入力" VerticalAlignment="Center"/>
                    <Button x:Name="ClearBtn" Content="クリア"
                            Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Right"
                            FontSize="12" Padding="10,4"
                            Click="ClearBtn_Click"/>
                </Grid>

                <!-- Code TextBox -->
                <TextBox x:Name="CodeInput" Grid.Row="1"
                         Style="{StaticResource CodeBox}"
                         Text="// ここにレビューしたいコードを貼り付けてください"
                         GotFocus="CodeInput_GotFocus"/>

                <!-- Action buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button x:Name="ReviewBtn"
                            Content="▶  コードレビュー開始"
                            Style="{StaticResource PrimaryButton}"
                            IsEnabled="False"
                            Click="ReviewBtn_Click"/>
                </StackPanel>
            </Grid>

            <!-- ── Splitter ── -->
            <GridSplitter Grid.Column="1" Width="4"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>

            <!-- ── Right panel: Review results ── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Results header with summary badges -->
                <Grid Grid.Row="0" Margin="8,0,0,8">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="📋  レビュー結果" VerticalAlignment="Center"/>
                    <StackPanel x:Name="SummaryPanel" Orientation="Horizontal"
                                HorizontalAlignment="Right" Visibility="Collapsed">
                        <Border x:Name="HighBadge" CornerRadius="10" Padding="8,2" Margin="2,0"
                                Background="#3A1515">
                            <TextBlock x:Name="HighCount" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource SeverityHighBrush}"/>
                        </Border>
                        <Border x:Name="MedBadge" CornerRadius="10" Padding="8,2" Margin="2,0"
                                Background="#3A2C15">
                            <TextBlock x:Name="MedCount" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource SeverityMedBrush}"/>
                        </Border>
                        <Border x:Name="LowBadge" CornerRadius="10" Padding="8,2" Margin="2,0"
                                Background="#153A20">
                            <TextBlock x:Name="LowCount" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource SeverityLowBrush}"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Results list -->
                <Border Grid.Row="1" Margin="8,0,0,0"
                        Background="{StaticResource BgMidBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <!-- Empty state -->
                        <StackPanel x:Name="EmptyState"
                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🤖" FontSize="40" HorizontalAlignment="Center"/>
                            <TextBlock Text="コードを貼り付けてレビューを開始してね"
                                       FontSize="13" Margin="0,12,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Loading state -->
                        <StackPanel x:Name="LoadingState" Visibility="Collapsed"
                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="LoadingText"
                                       Text="レビュー中..."
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Results ItemsControl -->
                        <ScrollViewer x:Name="ResultsScroll" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="12">
                            <ItemsControl x:Name="ResultsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:ReviewItem}">
                                        <!-- ===== Review Card ===== -->
                                        <Border Margin="0,0,0,10" CornerRadius="8"
                                                Background="{StaticResource BgCardBrush}"
                                                BorderThickness="1,1,1,1">
                                            <Border.BorderBrush>
                                                <Binding Path="Severity" Converter="{StaticResource SevColorConv}"/>
                                            </Border.BorderBrush>
                                            <Grid Margin="14,12">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Card header: severity badge + category + title -->
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Severity pill -->
                                                    <Border Grid.Column="0" CornerRadius="4" Padding="6,2"
                                                            Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <Border.Background>
                                                            <Binding Path="Severity" Converter="{StaticResource SevColorConv}"
                                                                     ConverterParameter="bg"/>
                                                        </Border.Background>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Margin="0,0,4,0" VerticalAlignment="Center">
                                                                <TextBlock.Text>
                                                                    <Binding Path="Severity" Converter="{StaticResource SevIconConv}"/>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                            <TextBlock FontSize="11" FontWeight="Bold" VerticalAlignment="Center">
                                                                <TextBlock.Text>
                                                                    <Binding Path="Severity" Converter="{StaticResource SevLabelConv}"/>
                                                                </TextBlock.Text>
                                                                <TextBlock.Foreground>
                                                                    <Binding Path="Severity" Converter="{StaticResource SevColorConv}"/>
                                                                </TextBlock.Foreground>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Category + Title -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Category}"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   Margin="0,0,0,1"/>
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Description -->
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Description}"
                                                           Margin="0,8,0,0"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           FontSize="12"
                                                           LineHeight="18"/>

                                                <!-- Line hint (optional) -->
                                                <Border Grid.Row="2"
                                                        Visibility="{Binding LineHint, Converter={StaticResource NullToCollapsed}}"
                                                        Margin="0,8,0,0"
                                                        Background="#12121E"
                                                        CornerRadius="4"
                                                        Padding="8,4">
                                                    <TextBlock Text="{Binding LineHint}"
                                                               FontFamily="Cascadia Code, Consolas"
                                                               FontSize="11"
                                                               Foreground="#9CDCFE"
                                                               TextWrapping="Wrap"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- No issues found state -->
                        <StackPanel x:Name="NoIssuesState" Visibility="Collapsed"
                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="✅" FontSize="40" HorizontalAlignment="Center"/>
                            <TextBlock Text="問題は見つかりませんでした！"
                                       FontSize="13" Margin="0,12,0,0"
                                       Foreground="{StaticResource SeverityLowBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== Status bar ===== -->
        <Border Grid.Row="2"
                Background="{StaticResource BgMidBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <TextBlock x:Name="StatusLabel" Style="{StaticResource StatusLabel}"
                           Text="アプリを起動中..." VerticalAlignment="Center"/>
                <TextBlock Text="対象: 関数単位のコード  ·  レビュー項目: うっかりミス / セキュリティ"
                           HorizontalAlignment="Right"
                           Style="{StaticResource StatusLabel}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
